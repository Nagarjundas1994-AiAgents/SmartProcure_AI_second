{
  "name": "smartprocure-enterprise",
  "version": "1.0.0",
  "description": "SmartProcure - AI-powered enterprise procurement and supplier management on SAP CAP",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "mock:portal": "node mocks/supplier-portal-mock.js",
    "test": "node --test --test-concurrency=1 test/*/*.test.js",
    "test:procurement": "node --test test/procurement/*.test.js",
    "test:supplier": "node --test test/supplier/*.test.js",
    "test:integrations": "node --test test/integrations/*.test.js",
    "test:agents": "node --test test/agents/*.test.js"
  },
  "dependencies": {
    "@cap-js/agents": "^0.9.10",
    "@cap-js/hana": "^3",
    "@cap-js/mcp": "^1.5.0",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "alice": {
            "password": "alice",
            "roles": [
              "Employee"
            ]
          },
          "bob": {
            "password": "bob",
            "roles": [
              "Employee",
              "Manager"
            ]
          },
          "carol": {
            "password": "carol",
            "roles": [
              "ProcurementOfficer"
            ]
          },
          "dave": {
            "password": "dave",
            "roles": [
              "WarehouseEmployee"
            ]
          },
          "erin": {
            "password": "erin",
            "roles": [
              "Employee"
            ]
          },
          "frank": {
            "password": "frank",
            "roles": [
              "Employee",
              "Manager"
            ]
          },
          "admin": {
            "password": "admin",
            "roles": [
              "Administrator"
            ]
          },
          "nobody": {
            "password": "nobody",
            "roles": []
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      },
      "destinations": true,
      "API_PURCHASEORDER_PROCESS_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_PURCHASEORDER_PROCESS_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4HANA_PO",
            "path": "/sap/opu/odata/sap/API_PURCHASEORDER_PROCESS_SRV"
          }
        }
      },
      "API_MATERIAL_DOCUMENT_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_MATERIAL_DOCUMENT_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4HANA_PO",
            "path": "/sap/opu/odata/sap/API_MATERIAL_DOCUMENT_SRV"
          }
        }
      },
      "SupplierPortal": {
        "kind": "rest",
        "credentials": {
          "url": "http://localhost:4010",
          "[production]": { "credentials": { "destination": "SUPPLIER_PORTAL" } }
        },
        "[production]": {
          "credentials": {
            "destination": "SUPPLIER_PORTAL"
          }
        }
      },
      "llm": {
        "kind": "llm-mock",
        "[production]": {
          "kind": "aicore/sonnet"
        }
      }
    },
    "mcp": {
      "autowire": false,
      "per_action_tool": true
    }
  }
}